@model IEnumerable<ASPSTUDENT4.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Class</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.MaSV</td>
                    <td>@student.HoTen</td>
                    <td>@student.LopHoc.TenLop</td>  <!-- Sử dụng LopHoc.TenLop -->
                    <td>
                        <a href="@Url.Action("Details", "Student", new { id = student.MaSV })" class="btn btn-info">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
